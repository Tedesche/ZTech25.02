<?xml version="1.0" encoding="UTF-8"?> 
<project xmlns="http://maven.apache.org/POM/4.0.0" 
	   	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.4.5</version>
		<relativePath/> </parent>
	<groupId>com.example</groupId>
	<artifactId>ZtechTeste</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>ZtechAplication</name>
	<description>Demo project for Spring Boot</description>
	<url/>
	<licenses>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>
   	    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>
	<dependencies>
		<!-- Dependências da Aplicação -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>	 
		
		<!-- Ferramentas e Utilitários -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
     		<groupId>com.h2database</groupId>
     		<artifactId>h2</artifactId>
     	   	<scope>runtime</scope>
        </dependency>
		<dependency>
    		<groupId>org.projectlombok</groupId>
   			<artifactId>lombok</artifactId>
   			<version>1.18.38</version> 
			<scope>provided</scope> 
		</dependency>	
		<dependency>
    		<groupId>com.google.guava</groupId>
    		<artifactId>guava</artifactId>
    		<version>31.1-jre</version> 
    	</dependency>

		<!-- Testes -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
		

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			  <plugin>
                <groupId>org.jacoco</groupId>
    			<artifactId>jacoco-maven-plugin</artifactId>
    			<version>0.8.12</version>
    			<configuration>
			        <excludes>
			        	<!-- Pasta classes Aplication -->
			            <exclude>**/ZtechAplication/DataConfiguration.class</exclude>
			            <exclude>**/ZtechAplication/ZtechAplicationAplication.class</exclude>
			            
			            <!-- Pasta classes config -->
			            <exclude>**/ZtechAplication/config/CustomAuthenticationSuccessHandler.class</exclude>
			           
			            <!-- Pasta classes DTO -->
			            <exclude>**/ZtechAplication/DTO/**</exclude>
			            
			            <!-- Pasta classes model -->
						<exclude>**/Categoria.class</exclude>
						<exclude>**/Cliente.class</exclude>
						<exclude>**/Email.class</exclude>
						<exclude>**/Endereco.class</exclude>
						<exclude>**/Funcionario.class</exclude>
						<exclude>**/Marca.class</exclude>
						
						<exclude>**/Servico.class</exclude>
						<exclude>**/Telefone.class</exclude>
						<exclude>**/Usuario.class</exclude>
						<exclude>**/Venda.class</exclude>
						
						<!-- Pasta classes pagina -->
						<exclude>ZtechAplication/pagina/CategoriaController.class</exclude>
					    <exclude>ZtechAplication/pagina/ClienteController.class</exclude>
					    <exclude>ZtechAplication/pagina/FuncionarioController.class</exclude>
					    <exclude>ZtechAplication/pagina/indexController.class</exclude>
					    <exclude>ZtechAplication/pagina/MarcaController.class</exclude>
					    <exclude>ZtechAplication/pagina/OrdemServicoController.class</exclude>
					    <exclude>ZtechAplication/pagina/ProdutoController.class</exclude>
					    <exclude>ZtechAplication/pagina/ServicoController.class</exclude>
					    <exclude>ZtechAplication/pagina/SpecificationController.class</exclude>
					    <exclude>ZtechAplication/pagina/StatusLibrary.class</exclude>
			            
			            <!-- Pasta classes service -->
			            <exclude>ZtechAplication/service/DetalhesUsuarioServiceImpl.class</exclude>
    					<exclude>ZtechAplication/service/EmailService.class</exclude>
			        </excludes>
		  	    </configuration>		
                <executions>
                    <!-- Inicializa o agente do JaCoCo antes dos testes rodarem -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- Gera o relatório após a execução dos testes -->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
		</plugins>
	</build>

</project>